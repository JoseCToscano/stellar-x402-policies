# Copy this file to .env and fill in testnet values there.
# .env is gitignored. Never commit real keys, account seeds, or signed payloads.

# Facilitator account seed (S...). This account submits the transaction and pays the fee.
FACILITATOR_SECRET_KEY=

# Payer seed for a separate client that builds the smart-account auth entry.
# The facilitator and the demo script do not read this variable.
PAYER_SECRET_KEY=

# stellar:testnet or stellar:pubnet. Pubnet needs STELLAR_RPC_URL.
STELLAR_NETWORK=stellar:testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Comma-separated policy contract ids (C...). Events from these contracts are
# eligible to be ignored when the topic is not balance-moving.
POLICY_CONTRACT_IDS=

# Optional comma-separated topic allowlist. Recommended for OpenZeppelin
# stellar-accounts policies. Leave empty to accept any non-balance-moving
# topic from POLICY_CONTRACT_IDS.
POLICY_EVENT_TOPICS=spending_limit_enforced,simple_enforced,merchant_cap_enforced,period_cap_enforced

# Set to 1 to treat a CAP-84 W payTo as its base contract. Off until Protocol 30.
MATCH_MUXED_CONTRACT=

# warm (default) or cold (first-touch rent). Caps below override the profile.
FEE_PROFILE=warm
WARM_FEE_CAP_STROOPS=
COLD_FEE_CAP_STROOPS=
MAX_TRANSACTION_FEE_STROOPS=

# Required only when verifying or settling a payload.
ASSET_CONTRACT_ID=
PAY_TO=
AMOUNT=
PAYMENT_TRANSACTION_XDR=
MAX_TIMEOUT_SECONDS=60

# Demo only. true submits the transaction. Any other value verifies only.
SETTLE=false

# Facilitator HTTP server.
PORT=4020
HOST=127.0.0.1
