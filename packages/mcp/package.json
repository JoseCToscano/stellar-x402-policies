{
  "name": "@stellar-x402-policies/mcp",
  "version": "0.1.0",
  "description": "MCP server for policy-aware x402 payments from Stellar smart accounts.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sxp-mcp": "./dist/stdio.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.build.json && vitest run",
    "start": "node dist/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@stellar-x402-policies/sdk": "workspace:*",
    "@stellar/stellar-sdk": "^16.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
